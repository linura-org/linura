root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,rs,cpp,cc,c,h,hpp,qml,lua}]
indent_size = 4
max_line_length = 100

[*.py]
max_line_length = 88

[*.{js,mjs,cjs,ts,tsx,jsx,json,jsonc,yml,yaml,toml}]
indent_size = 2
max_line_length = 100

[*.sh]
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

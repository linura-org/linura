<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- Private fixed native helper only; principal/event/owner are never args.
       Receipts are coverage bookkeeping, not lock or power credentials. -->
  <interface name="org.linura.SleepGate1">
    <annotation name="org.linura.ContractId" value="dbus.org.linura.SleepGate1"/>
    <annotation name="org.linura.ContractVersion" value="1"/>
    <annotation name="org.linura.Stability" value="experimental"/>
    <method name="ProtectBeforeSleep">
      <arg name="fenced" type="b" direction="out"/>
    </method>
  </interface>
</node>

<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.linura.Executor.Systemd1">
    <annotation name="org.linura.ContractId" value="dbus.org.linura.Executor.Systemd1"/>
    <annotation name="org.linura.ContractVersion" value="1"/>
    <annotation name="org.linura.Stability" value="experimental"/>
    <method name="SetUnitEnabled">
      <arg name="unit" type="s" direction="in"/>
      <arg name="enabled" type="b" direction="in"/>
      <arg name="request_id" type="s" direction="in"/>
    </method>
    <method name="RestartUnit">
      <arg name="unit" type="s" direction="in"/>
      <arg name="request_id" type="s" direction="in"/>
    </method>
    <method name="SetManagedActiveState">
      <arg name="unit" type="s" direction="in"/>
      <arg name="desired_active_state" type="s" direction="in"/>
      <arg name="transaction_id" type="s" direction="in"/>
      <arg name="generation" type="t" direction="in"/>
      <arg name="state_version" type="t" direction="in"/>
      <arg name="authority_binding_digest" type="s" direction="in"/>
      <arg name="authority_use_digest" type="s" direction="in"/>
      <arg name="effect_digest" type="s" direction="in"/>
      <arg name="dispatch_digest" type="s" direction="in"/>
      <arg name="outcome" type="(sss)" direction="out"/>
    </method>
  </interface>
</node>

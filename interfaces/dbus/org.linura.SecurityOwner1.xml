<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- Private native adapter; no public client mutation/authentication API. -->
  <interface name="org.linura.SecurityOwner1">
    <annotation name="org.linura.ContractId" value="dbus.org.linura.SecurityOwner1"/>
    <annotation name="org.linura.ContractVersion" value="1"/>
    <annotation name="org.linura.Stability" value="experimental"/>
    <!-- Approval scope: exact resource, authenticated principal, request, plan,
         request/evidence/review digests, and purpose (0 lock, 1 unlock,
         2 suspend, 3 logout, 4 reboot, 5 power-off, 6 enable protective locking,
         7 revoke protective locking). Lock/unlock/settings require a
         SessionLockId; only purposes 2..5 require the matching SessionTransitionId.
         Each authentication proves only this scope; it never dispatches an
         effect or releases a lock. Power authentication requires secure coverage. -->
    <method name="ArmApproval">
      <arg name="scope" type="(sssssssu)" direction="in"/>
      <arg name="armed" type="b" direction="out"/>
    </method>
    <method name="ConsumeApproval">
      <arg name="scope" type="(sssssssu)" direction="in"/>
      <arg name="consumed" type="b" direction="out"/>
    </method>
    <method name="CancelApproval"/>
    <method name="ObserveLock">
      <!-- Consistent in-flight acquisition/release returns the fixed private
           NativeTransitionPending error, never secure=false. Other unknown or
           inconsistent state remains NativeUnavailable. Only Control's existing
           bounded post-dispatch verification loop may await a known transition. -->
      <arg name="observation" type="(sbt)" direction="out"/>
    </method>
    <method name="ObserveDisplay">
      <arg name="observation" type="(ssstssb)" direction="out"/>
    </method>
    <!-- Read-only, admitted only for the independently supervised session executor.
         sampleDigest correlates strictly parsed raw facts; it is not authority. -->
    <method name="ObservePreparedDisplay">
      <arg name="observation" type="((ssstssb)s)" direction="out"/>
    </method>
    <!-- Read-only; supervised Control only. Complete canonical intent and
         immutable native correlation scope this get_status probe. Phases are
         native facts, never verified layout, approval or replay permission. -->
    <method name="ObserveDisplayAttempt">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="observation" type="(sssttub)" direction="out"/>
    </method>
    <!-- Prepared executor only. The strict Rust decoder's exact sample digest
         and ORIGINAL boot timestamp must survive a same-owner fresh recheck.
         The original canonical baseline guard must match final native ownership.
         One apply only; a phase is not independent verification or keep authority. -->
    <method name="DispatchPreparedDisplay">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="sample_digest" type="s" direction="in"/>
      <arg name="sampled_boot_ms" type="t" direction="in"/>
      <arg name="native_baseline_guard" type="s" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <method name="ObservePowerPermission">
      <arg name="resource" type="s" direction="in"/>
      <arg name="observation" type="(sst)" direction="out"/>
    </method>
    <!-- Coverage fence, not dispatch or approval. Only the attested executor
         may arm/cancel-before-OS-dispatch. Control's verified commit also needs
         the owner's own fresh kernel suspend-cycle and coverage observation. -->
    <method name="FencePreparedTransition">
      <arg name="resource" type="s" direction="in"/>
      <arg name="fenced" type="b" direction="out"/>
    </method>
    <method name="CancelUndispatchedTransition">
      <arg name="resource" type="s" direction="in"/>
      <arg name="cancelled" type="b" direction="out"/>
    </method>
    <method name="CommitVerifiedTransition">
      <arg name="resource" type="s" direction="in"/>
      <arg name="committed" type="b" direction="out"/>
    </method>
    <!-- Attested Control only; checks the fixed native pre-start invocation,
         fresh independent coverage and native kernel baseline. No dispatch or
         approval. Retired by the owner only after the exact job has ended;
         no public/client cancellation or timeout-release endpoint exists. -->
    <method name="FenceSleepEntry">
      <arg name="event" type="s" direction="in"/>
      <arg name="lock" type="s" direction="in"/>
      <arg name="fenced" type="b" direction="out"/>
    </method>
    <method name="DispatchPreparedLock">
      <arg name="resource" type="s" direction="in"/>
      <arg name="secure" type="b" direction="in"/>
      <arg name="dispatched" type="b" direction="out"/>
    </method>
    <method name="VerifyReleased">
      <arg name="resource" type="s" direction="in"/>
      <arg name="verified" type="b" direction="out"/>
    </method>
    <!-- Retained proof from the first independent VerifyReleased transition.
         Never mutates mechanism or rotates generation. Attested Control only;
         the same current lock, independent unlocked compositor, clear coverage
         and inactive sleep fence remain mandatory. Ready is never proof. -->
    <method name="RetainedVerifiedRelease">
      <arg name="resource" type="s" direction="in"/>
      <arg name="retained" type="b" direction="out"/>
    </method>
    <method name="CommitVerifiedRelease">
      <arg name="resource" type="s" direction="in"/>
      <arg name="committed" type="b" direction="out"/>
    </method>
    <signal name="ApprovalInteractionCompleted"/>
  </interface>
</node>

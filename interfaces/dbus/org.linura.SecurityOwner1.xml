<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- Private native adapter; no public client mutation/authentication API. -->
  <interface name="org.linura.SecurityOwner1">
    <annotation name="org.linura.ContractId" value="dbus.org.linura.SecurityOwner1"/>
    <annotation name="org.linura.ContractVersion" value="1"/>
    <annotation name="org.linura.Stability" value="experimental"/>
    <!-- Approval scope: exact resource, authenticated principal, request, plan,
         request/evidence/review digests, and purpose (0 lock, 1 unlock,
         2 suspend, 3 logout, 4 reboot, 5 power-off, 6 enable protective locking,
         7 revoke protective locking). Lock/unlock/settings require a
         SessionLockId; only purposes 2..5 require the matching SessionTransitionId.
         Each authentication proves only this scope; it never dispatches an
         effect or releases a lock. Power authentication requires secure coverage. -->
    <method name="ArmApproval">
      <arg name="scope" type="(sssssssu)" direction="in"/>
      <arg name="armed" type="b" direction="out"/>
    </method>
    <method name="ConsumeApproval">
      <arg name="scope" type="(sssssssu)" direction="in"/>
      <arg name="consumed" type="b" direction="out"/>
    </method>
    <method name="CancelApproval"/>
    <!-- Control-only safety cancellation in this exact current lock generation.
         Requests only the original display compensation. Ready requires the
         native display fence to be retired, not an ACK or elapsed timer. It
         grants no lock/power/unlock authority; Control owns bounded polling. -->
    <method name="RetireDisplayForSecurity">
      <arg name="resource" type="s" direction="in"/>
      <arg name="ready" type="b" direction="out"/>
    </method>
    <!-- Separate display Apply (purpose 8), fresh original restoration (11)
         and original-restoration finalization (12). Original canonical scope/review,
         complete material/reason and both original review bounds are immutable
         comparison data; no bool or digest becomes prepared execution authority.
         Finalization requires the actual held Recovery scene and a fresh bounded
         administrator conversation. Keep/Revert continue their original native
         transaction. No approval releases startup, input, power or lock fences. -->
    <method name="ArmDisplayApproval">
      <arg name="scope" type="(sssssssu)" direction="in"/>
      <arg name="material" type="s" direction="in"/>
      <arg name="reason" type="s" direction="in"/>
      <arg name="deadline_unix_ms" type="t" direction="in"/>
      <arg name="deadline_boot_ms" type="t" direction="in"/>
      <arg name="armed" type="b" direction="out"/>
    </method>
    <method name="DisplayApprovalReady">
      <arg name="scope" type="(sssssssu)" direction="in"/>
      <arg name="material" type="s" direction="in"/>
      <arg name="reason" type="s" direction="in"/>
      <arg name="deadline_unix_ms" type="t" direction="in"/>
      <arg name="deadline_boot_ms" type="t" direction="in"/>
      <arg name="ready" type="b" direction="out"/>
    </method>
    <method name="ConsumeDisplayApproval">
      <arg name="scope" type="(sssssssu)" direction="in"/>
      <arg name="material" type="s" direction="in"/>
      <arg name="reason" type="s" direction="in"/>
      <arg name="deadline_unix_ms" type="t" direction="in"/>
      <arg name="deadline_boot_ms" type="t" direction="in"/>
      <arg name="consumed" type="b" direction="out"/>
    </method>
    <method name="CancelDisplayApproval">
      <arg name="scope" type="(sssssssu)" direction="in"/>
      <arg name="material" type="s" direction="in"/>
      <arg name="reason" type="s" direction="in"/>
      <arg name="deadline_unix_ms" type="t" direction="in"/>
      <arg name="deadline_boot_ms" type="t" direction="in"/>
      <arg name="cancelled" type="b" direction="out"/>
    </method>
    <method name="ArmDisplayDecision">
      <arg name="principal" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="decision_digest" type="s" direction="in"/>
      <arg name="confirm" type="b" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <method name="DisplayDecisionReady">
      <arg name="principal" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="decision_digest" type="s" direction="in"/>
      <arg name="confirm" type="b" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <method name="ConsumeDisplayDecision">
      <arg name="principal" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="decision_digest" type="s" direction="in"/>
      <arg name="confirm" type="b" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <method name="CancelDisplayDecision">
      <arg name="principal" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="decision_digest" type="s" direction="in"/>
      <arg name="confirm" type="b" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <method name="ObserveLock">
      <!-- Consistent in-flight acquisition/release returns the fixed private
           NativeTransitionPending error, never secure=false. Other unknown or
           inconsistent state remains NativeUnavailable. Only Control's existing
           bounded post-dispatch verification loop may await a known transition. -->
      <arg name="observation" type="(sbt)" direction="out"/>
    </method>
    <method name="ObserveDisplay">
      <arg name="observation" type="(ssstssb)" direction="out"/>
    </method>
    <!-- Read-only, admitted only for the independently supervised session executor.
         sampleDigest correlates strictly parsed raw facts; it is not authority.
         The last field retains bounded original rule/overlay preimages for the
         private root checkpoint. These never enter ordinary observations. -->
    <method name="ObservePreparedDisplay">
      <arg name="observation" type="((ssstssb)ss)" direction="out"/>
    </method>
    <!-- Read-only; independently supervised Control only. Fresh private KMS and
         immutable post-write hardware frame facts. Never release authority. -->
    <method name="ObserveOriginalDisplayPresentation">
      <arg name="facts" type="s" direction="out"/>
    </method>
    <!-- Read-only; supervised Control only. Distinct first ordinary-frame
         comparison after one-use terminal spend, retaining original absolute
         wall/BOOTTIME deadlines and all input/lock/power/startup fences. -->
    <method name="ObserveNativeDisplayHandoff">
      <arg name="facts" type="s" direction="out"/>
    </method>
    <!-- Read-only; supervised Control only. Fresh actual current KMS, ordinary
         frames and physical input retirement after the original Root handoff.
         Cannot substitute first-frame evidence or authorize fence retirement. -->
    <method name="ObserveNativeDisplayCurrent">
      <arg name="facts" type="s" direction="out"/>
    </method>
    <!-- Read-only; supervised Control only. Complete canonical intent and
         immutable native correlation scope this get_status probe. Phases are
         native facts, never verified layout, approval or replay permission. -->
    <method name="ObserveOrdinaryDisplayHandoff">
      <arg name="facts" type="s" direction="out"/>
    </method>
    <method name="ObserveDisplayAttempt">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="observation" type="(sssttub)" direction="out"/>
    </method>
    <!-- Prepared executor only. The strict Rust decoder's exact sample digest
         and ORIGINAL boot timestamp must survive a same-owner fresh recheck.
         The original canonical baseline guard must match final native ownership.
         One apply only; a phase is not independent verification or keep authority. -->
    <method name="DispatchPreparedDisplay">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="sample_digest" type="s" direction="in"/>
      <arg name="sampled_boot_ms" type="t" direction="in"/>
      <arg name="native_baseline_guard" type="s" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <method name="DispatchPreparedSuccessorDisplay">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="sample_digest" type="s" direction="in"/>
      <arg name="sampled_boot_ms" type="t" direction="in"/>
      <arg name="native_baseline_guard" type="s" direction="in"/>
      <arg name="preparation" type="ay" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <!-- Distinct prepared Recovery purpose and one-use original Root endpoint.
         Complete LNRI material and original sample time remain bound. -->
    <method name="RestoreOriginalDisplay">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="sample_digest" type="s" direction="in"/>
      <arg name="sampled_boot_ms" type="t" direction="in"/>
      <arg name="original_grant" type="h" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <!-- Separately consumed terminal purpose/current supervised executor only.
         Exact retired receipt, fresh sample and one-use original-Root channel;
         acknowledgement never releases protection or proves completion. -->
    <method name="QuiesceOriginalDisplayFinalization">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="sample_digest" type="s" direction="in"/>
      <arg name="sampled_boot_ms" type="t" direction="in"/>
      <arg name="terminal_grant" type="h" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <!-- One-use original Root native release-spend attempt from authenticated
         Control, with immutable terminal/Root ancestry. Wire phase 6 proves
         only the before-effect spend, never physical release or unlock. -->
    <method name="SpendOrdinaryDisplayRelease">
      <!-- Exact consumed purpose-13 review plus one actual original Root grant.
           Accepted does not prove physical frames or retire input/power. -->
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="sample_digest" type="s" direction="in"/>
      <arg name="sampled_boot_ms" type="t" direction="in"/>
      <arg name="grant" type="h" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <method name="SpendOriginalDisplayNativeRelease">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="sample_digest" type="s" direction="in"/>
      <arg name="sampled_boot_ms" type="t" direction="in"/>
      <arg name="control_version" type="t" direction="in"/>
      <arg name="control_binding" type="s" direction="in"/>
      <arg name="control_observation" type="s" direction="in"/>
      <arg name="native_grant" type="h" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <!-- One-use current-lifetime transfer from the current authenticated
         Control process. Phase 8 is not physical release or completion. -->
    <method name="RetireOriginalDisplayCurrent">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="preparation_digest" type="s" direction="in"/>
      <arg name="preparation" type="ay" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <method name="CommitOriginalDisplayCurrent">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="preparation_digest" type="s" direction="in"/>
      <arg name="preparation" type="ay" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <method name="RetireOriginalDisplayPower">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="preparation_digest" type="s" direction="in"/>
      <arg name="preparation" type="ay" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <method name="TransferOriginalDisplayCompletion">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="preparation_digest" type="s" direction="in"/>
      <arg name="completion_grant" type="h" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <method name="TransferOrdinaryDisplayCompletion">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="preparation_digest" type="s" direction="in"/>
      <arg name="completion_grant" type="h" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <!-- Current attested executor only, following Control's consumed/durable
         protected decision. Original connection/reservation, layout, lock/input
         coverage and original deadline remain mandatory. No new apply, replay,
         reconnection privilege or independent verification is provided. -->
    <method name="ContinuePreparedDisplay">
      <arg name="query" type="(sssst)" direction="in"/>
      <arg name="decision_digest" type="s" direction="in"/>
      <arg name="protected_decision_digest" type="s" direction="in"/>
      <arg name="confirm" type="b" direction="in"/>
      <arg name="phase" type="u" direction="out"/>
    </method>
    <method name="ObservePowerPermission">
      <arg name="resource" type="s" direction="in"/>
      <arg name="observation" type="(sst)" direction="out"/>
    </method>
    <!-- Coverage fence, not dispatch or approval. Only the attested executor
         may arm/cancel-before-OS-dispatch. Control's verified commit also needs
         the owner's own fresh kernel suspend-cycle and coverage observation. -->
    <method name="FencePreparedTransition">
      <arg name="resource" type="s" direction="in"/>
      <arg name="fenced" type="b" direction="out"/>
    </method>
    <method name="CancelUndispatchedTransition">
      <arg name="resource" type="s" direction="in"/>
      <arg name="cancelled" type="b" direction="out"/>
    </method>
    <method name="CommitVerifiedTransition">
      <arg name="resource" type="s" direction="in"/>
      <arg name="committed" type="b" direction="out"/>
    </method>
    <!-- Attested Control only; checks the fixed native pre-start invocation,
         fresh independent coverage and native kernel baseline. No dispatch or
         approval. Retired by the owner only after the exact job has ended;
         no public/client cancellation or timeout-release endpoint exists. -->
    <method name="FenceSleepEntry">
      <arg name="event" type="s" direction="in"/>
      <arg name="lock" type="s" direction="in"/>
      <arg name="fenced" type="b" direction="out"/>
    </method>
    <method name="DispatchPreparedLock">
      <arg name="resource" type="s" direction="in"/>
      <arg name="secure" type="b" direction="in"/>
      <arg name="dispatched" type="b" direction="out"/>
    </method>
    <method name="VerifyReleased">
      <arg name="resource" type="s" direction="in"/>
      <arg name="verified" type="b" direction="out"/>
    </method>
    <!-- Retained proof from the first independent VerifyReleased transition.
         Never mutates mechanism or rotates generation. Attested Control only;
         the same current lock, independent unlocked compositor, clear coverage
         and inactive sleep fence remain mandatory. Ready is never proof. -->
    <method name="RetainedVerifiedRelease">
      <arg name="resource" type="s" direction="in"/>
      <arg name="retained" type="b" direction="out"/>
    </method>
    <method name="CommitVerifiedRelease">
      <arg name="resource" type="s" direction="in"/>
      <arg name="committed" type="b" direction="out"/>
    </method>
    <signal name="ApprovalInteractionCompleted"/>
  </interface>
</node>

<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.linura.Session1">
    <annotation name="org.linura.ContractId" value="dbus.org.linura.Session1"/>
    <annotation name="org.linura.ContractVersion" value="1"/>
    <annotation name="org.linura.Stability" value="experimental"/>
    <method name="SetAudioOutputVolume">
      <arg name="request_id" type="s" direction="in"/>
      <arg name="node_id" type="u" direction="in"/>
      <arg name="volume_percent" type="q" direction="in"/>
      <arg name="reason" type="s" direction="in"/>
      <arg name="receipt" type="(sssssss)" direction="out"/>
    </method>
  </interface>
</node>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linura.org/schemas/setup.v1.schema.json",
  "title": "Linura Reusable Setup v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "description",
    "revision",
    "intents",
    "includes",
    "constraints",
    "required_secret_refs",
    "hardware_hints"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_secret_refs": {
      "description": "References/requirements only. Portable setups never embed secret values.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._-]+:[A-Za-z0-9._-]+$"
      },
      "uniqueItems": true
    },
    "hardware_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "intents": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "includes": {
          "minItems": 1
        }
      }
    }
  ],
  "x-linura-contract-id": "schema.setup.v1",
  "x-linura-stability": "experimental"
}

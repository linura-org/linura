{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linura.org/schemas/intent-proposal.v1.schema.json",
  "title": "Linura Intent Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "actor",
    "requested_outcome",
    "requirements",
    "capability_refs",
    "assumptions",
    "unresolved_questions",
    "context",
    "attribution",
    "explanation",
    "canonical_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "proposal_id": { "$ref": "#/$defs/coreId" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "interactive"],
      "properties": {
        "id": { "$ref": "#/$defs/coreId" },
        "kind": { "enum": ["human", "service", "agent", "remote"] },
        "interactive": { "type": "boolean" }
      }
    },
    "requested_outcome": { "$ref": "#/$defs/nonEmptyText" },
    "requirements": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "statement"],
        "properties": {
          "id": { "$ref": "#/$defs/coreId" },
          "kind": { "enum": ["goal", "constraint", "preference", "prohibition"] },
          "statement": { "$ref": "#/$defs/nonEmptyText" }
        }
      }
    },
    "capability_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/coreId" }
    },
    "assumptions": { "$ref": "#/$defs/textList" },
    "unresolved_questions": { "$ref": "#/$defs/textList" },
    "confidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["permille"],
      "properties": { "permille": { "type": "integer", "minimum": 0, "maximum": 1000 } }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_revision", "semantic_input_digest", "source_revisions"],
      "properties": {
        "authority_revision": { "$ref": "#/$defs/token" },
        "semantic_input_digest": { "$ref": "#/$defs/digest" },
        "source_revisions": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "revision"],
            "properties": {
              "kind": { "enum": ["observation", "policy", "library", "capability-registry", "existing-intent"] },
              "id": { "$ref": "#/$defs/token" },
              "revision": { "$ref": "#/$defs/token" }
            }
          }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "adapter", "manual"],
      "properties": {
        "provider": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/token" }
          ]
        },
        "model": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/token" }
          ]
        },
        "adapter": { "$ref": "#/$defs/token" },
        "manual": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "manual": { "const": true } }, "required": ["manual"] },
          "then": { "properties": { "provider": { "type": "null" }, "model": { "type": "null" } } }
        },
        {
          "if": { "properties": { "manual": { "const": false } }, "required": ["manual"] },
          "then": { "properties": { "provider": { "$ref": "#/$defs/token" } } }
        }
      ]
    },
    "explanation": { "$ref": "#/$defs/textList" },
    "canonical_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "coreId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "token": {
      "type": "string",
      "maxLength": 256,
      "allOf": [
        { "pattern": "\\S" },
        { "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" }
      ]
    },
    "text": {
      "type": "string",
      "maxLength": 16384,
      "pattern": "^[^\\u0000]*$"
    },
    "nonEmptyText": {
      "allOf": [
        { "$ref": "#/$defs/text" },
        { "pattern": "\\S" }
      ]
    },
    "textList": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/text" }
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "x-linura-contract-id": "schema.intent-proposal.v1",
  "x-linura-stability": "experimental",
  "x-linura-authority": "proposal-only",
  "x-linura-aggregate-byte-limit": 524288
}

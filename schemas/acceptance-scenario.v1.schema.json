{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linura.org/schemas/acceptance-scenario.v1.schema.json",
  "title": "Linura VM acceptance scenario",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "description",
    "requires",
    "steps",
    "execution_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "executable",
        "reserved"
      ]
    },
    "reservation_reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "additionalProperties": false,
  "x-linura-contract-id": "schema.acceptance-scenario.v1",
  "x-linura-stability": "experimental",
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "reserved"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "required": [
          "reservation_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "executable"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "reservation_reason"
          ]
        }
      }
    }
  ]
}

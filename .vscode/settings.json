{
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": [
    "--all-features",
    "--locked"
  ],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.rulers": [
      88,
      100,
      120
    ]
  },
  "ruff.path": [
    "${userHome}/.local/bin/ruff"
  ],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.extraPaths": [
    "./tools",
    "./bindings/python/src"
  ],
  "cSpell.words": [
    "airootfs",
    "appstream",
    "archiso",
    "bluez",
    "clippy",
    "cloudflare",
    "cmake",
    "codeql",
    "codex",
    "dbus",
    "enospc",
    "ffv1",
    "flathub",
    "glibc",
    "hyprland",
    "libvirt",
    "linura",
    "linuractl",
    "linurad",
    "logind",
    "mkarchiso",
    "nixos",
    "nocloud",
    "pipewire",
    "polkit",
    "pylance",
    "pypi",
    "qemu",
    "qml",
    "qtquick",
    "quickshell",
    "ruff",
    "rustfmt",
    "rustsec",
    "rustup",
    "shellcheck",
    "shfmt",
    "wayland",
    "wireplumber",
    "wlroots",
    "xwayland"
  ],
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "[qml]": {
    "editor.defaultFormatter": "theqtcompany.qt-qml",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.rulers": [
      100,
      120,
      140
    ]
  },
  "C_Cpp.clang_format_style": "file",
  "prettier.requireConfig": true,
  "shellformat.flag": "-i 4 -ci"
}

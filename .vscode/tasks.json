{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "RUSTUP_AUTO_INSTALL": "0",
      "CARGO_BUILD_JOBS": "1",
      "PATH": "${userHome}/.local/linura-tools/python312/bin:${env:PATH}"
    }
  },
  "tasks": [
    {
      "label": "Linura: default environment",
      "type": "process",
      "command": "env",
      "args": [
        "-u",
        "CARGO_TARGET_DIR",
        "-u",
        "CARGO_BUILD_TARGET_DIR",
        "-u",
        "CARGO_BUILD_BUILD_DIR",
        "bash",
        "scripts/run_codex.sh",
        "python3",
        "tools/codex/doctor.py",
        "--profile",
        "core"
      ],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: complete environment inventory (not readiness)",
      "type": "process",
      "command": "env",
      "args": [
        "-u",
        "CARGO_TARGET_DIR",
        "-u",
        "CARGO_BUILD_TARGET_DIR",
        "-u",
        "CARGO_BUILD_BUILD_DIR",
        "bash",
        "scripts/run_codex.sh",
        "python3",
        "tools/codex/doctor.py",
        "--all"
      ],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: preflight",
      "type": "process",
      "command": "env",
      "args": [
        "-u",
        "CARGO_TARGET_DIR",
        "-u",
        "CARGO_BUILD_TARGET_DIR",
        "-u",
        "CARGO_BUILD_BUILD_DIR",
        "bash",
        "scripts/preflight_codex_environment.sh"
      ],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: output isolation",
      "type": "process",
      "command": "env",
      "args": [
        "-u",
        "CARGO_TARGET_DIR",
        "-u",
        "CARGO_BUILD_TARGET_DIR",
        "-u",
        "CARGO_BUILD_BUILD_DIR",
        "bash",
        "scripts/run_codex.sh",
        "python3",
        "tools/development_workspace.py",
        "outputs"
      ],
      "dependsOn": "Linura: preflight",
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: authority-test host",
      "type": "process",
      "command": "env",
      "args": [
        "-u",
        "CARGO_TARGET_DIR",
        "-u",
        "CARGO_BUILD_TARGET_DIR",
        "-u",
        "CARGO_BUILD_BUILD_DIR",
        "bash",
        "scripts/run_codex.sh",
        "python3",
        "tools/development_workspace.py",
        "authority-host"
      ],
      "dependsOn": "Linura: output isolation",
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: canonical check",
      "type": "process",
      "command": "env",
      "args": [
        "-u",
        "CARGO_TARGET_DIR",
        "-u",
        "CARGO_BUILD_TARGET_DIR",
        "-u",
        "CARGO_BUILD_BUILD_DIR",
        "bash",
        "scripts/run_codex.sh",
        "cargo",
        "xtask",
        "check"
      ],
      "dependsOn": "Linura: authority-test host",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: shell prerequisites",
      "type": "process",
      "command": "env",
      "args": [
        "-u",
        "CARGO_TARGET_DIR",
        "-u",
        "CARGO_BUILD_TARGET_DIR",
        "-u",
        "CARGO_BUILD_BUILD_DIR",
        "bash",
        "scripts/run_codex.sh",
        "python3",
        "tools/codex/doctor.py",
        "--profile",
        "shell"
      ],
      "dependsOn": "Linura: output isolation",
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: UI configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "apps/linura-shell/ui",
        "-B",
        "${workspaceFolder}/.artifacts/cmake/ui",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "dependsOn": "Linura: shell prerequisites",
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: UI build",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/.artifacts/cmake/ui", "--parallel", "1"],
      "dependsOn": "Linura: UI configure",
      "problemMatcher": ["$gcc"],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: bridge configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "apps/linura-shell/bridge",
        "-B",
        "${workspaceFolder}/.artifacts/cmake/bridge",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "dependsOn": "Linura: shell prerequisites",
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: bridge build",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/.artifacts/cmake/bridge", "--parallel", "1"],
      "dependsOn": "Linura: bridge configure",
      "problemMatcher": ["$gcc"],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: Qt editor inventory (not IDE acceptance)",
      "type": "process",
      "command": "env",
      "args": [
        "-u",
        "CARGO_TARGET_DIR",
        "-u",
        "CARGO_BUILD_TARGET_DIR",
        "-u",
        "CARGO_BUILD_BUILD_DIR",
        "bash",
        "scripts/run_codex.sh",
        "python3",
        "tools/development_workspace.py",
        "editor"
      ],
      "dependsOn": "Linura: Qt component builds (not qualification)",
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: heavy storage preflight (not qualification)",
      "type": "process",
      "command": "env",
      "args": [
        "-u",
        "CARGO_TARGET_DIR",
        "-u",
        "CARGO_BUILD_TARGET_DIR",
        "-u",
        "CARGO_BUILD_BUILD_DIR",
        "python3",
        "tools/development_workspace.py",
        "storage",
        "--environment",
        "local-heavy",
        "--run",
        "preflight",
        "--min-free-gib",
        "12",
        "--max-parallel-builds",
        "1"
      ],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Linura: Qt component builds (not qualification)",
      "dependsOn": ["Linura: UI build", "Linura: bridge build"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}

[Unit]
Description=Linura shell runtime qualification
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/quickshell -n -p /opt/linura-source/apps/linura-shell/qualification-controller.qml
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
Environment=QS_DISABLE_FILE_WATCHER=1
Environment=QML2_IMPORT_PATH=/usr/local/lib/qt6/qml
Environment=QT_QUICK_BACKEND=software

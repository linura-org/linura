cmake_minimum_required(VERSION 3.24)

if(NOT IS_DIRECTORY "${NATIVE_SOURCE_DIR}" OR NOT IS_DIRECTORY "${TEST_OUTPUT_DIR}")
    message(FATAL_ERROR "Identity regression needs explicit source and build roots")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
set(fixture "${TEST_OUTPUT_DIR}/integration-identity-${suffix}")
if(EXISTS "${fixture}")
    message(FATAL_ERROR "Identity fixture must be fresh")
endif()
file(MAKE_DIRECTORY "${fixture}")
file(COPY "${NATIVE_SOURCE_DIR}/" DESTINATION "${fixture}/source")
set(source "${fixture}/source")
set(output "${fixture}/identity")
include("${source}/integration_identity.cmake")
linura_display_integration_identity("${source}" "${output}")
file(READ "${output}/linura-display-integration-build.h" original_identity)
file(READ "${source}/source_integration.py" original_recipe)
file(APPEND "${source}/source_integration.py" "\n# Recipe-only edit must change live identity.\n")
linura_display_integration_identity("${source}" "${output}")
file(READ "${output}/linura-display-integration-build.h" changed_identity)
if(original_identity STREQUAL changed_identity)
    message(FATAL_ERROR "Native identity did not bind the upstream integration recipe")
endif()
file(WRITE "${source}/source_integration.py" "${original_recipe}")
linura_display_integration_identity("${source}" "${output}")
file(READ "${output}/linura-display-integration-build.h" restored_identity)
if(NOT original_identity STREQUAL restored_identity)
    message(FATAL_ERROR "Native source identity is not deterministic")
endif()

# A separately invoked CMake process must fail closed on an absent/substituted
# recipe. All mutations below affect only this fresh generated fixture.
file(WRITE "${fixture}/probe.cmake"
    "include(\"${source}/integration_identity.cmake\")\n"
    "linura_display_integration_identity(\"${source}\" \"${output}\")\n")
file(WRITE "${fixture}/original-recipe.py" "${original_recipe}")
file(REMOVE "${source}/source_integration.py")
file(CREATE_LINK "${fixture}/original-recipe.py" "${source}/source_integration.py" SYMBOLIC)
foreach(denial IN ITEMS substituted absent)
    if(denial STREQUAL absent)
        file(REMOVE "${source}/source_integration.py")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${fixture}/probe.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 3)
    if(result EQUAL 0 OR NOT stderr MATCHES "Missing or substituted pinned native integration source")
        message(FATAL_ERROR "Native identity accepted ${denial} integration recipe: ${stdout}${stderr}")
    endif()
endforeach()
